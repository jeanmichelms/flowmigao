# Copie para .env e ajuste os valores
# DB_ENGINE=sqlite   # descomente para usar SQLite em vez de MySQL
DB_NAME=flowmigao
DB_USER=flowmigao
DB_PASSWORD=troque-esta-senha
DB_HOST=localhost
DB_PORT=3306

# Opcional: conexão em uma única URL (tem prioridade sobre DB_*). No Railway: ${{MySQL.MYSQL_URL}}
# DATABASE_URL=mysql://usuario:senha@host:3306/banco

# Django. No computador local nada disso é obrigatório (DEBUG já fica ligado).
# DJANGO_DEBUG=True
# DJANGO_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
# DJANGO_ALLOWED_HOSTS=meudominio.com.br,www.meudominio.com.br
# DJANGO_CSRF_TRUSTED_ORIGINS=https://meudominio.com.br

# Aviso de revisão por e-mail
# AVISO_REVISAO_EMAIL_SERVICO_ATIVO=True
# DEFAULT_FROM_EMAIL=FlowMigao <seu-remetente-verificado@exemplo.com>

# Opção 1 (recomendada, obrigatória no Railway): API do Brevo. Com a chave definida, o SMTP abaixo é ignorado.
# BREVO_API_KEY=xkeysib-...

# Opção 2: SMTP
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seu-email@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app
